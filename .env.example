APP_ENV=development
DATABASE_URL=sqlite:///./tira.db
ADMIN_API_TOKEN=
LLM_PROVIDER=google_gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# For Groq, use LLM_PROVIDER=groq, set LLM_MODEL to a Groq Console model ID,
# and put the Groq key in LLM_API_KEY. Groq's base URL is selected automatically
# when LLM_BASE_URL is left at its Gemini default.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Optional no-key search: public SearXNG instance with JSON search enabled.
# Find instances at https://searx.space/; public instances may rate-limit or block JSON.
SEARXNG_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_REVIEW_CHAT_ID=
PUBLISH_MODE=manual
AUTO_PUBLISH_ENABLED=false
MIN_AUTO_IMPORTANCE_SCORE=8.5
MIN_AUTO_VERIFICATION_SCORE=0.95
AUTO_PUBLISH_CATEGORIES=[]
MAX_POSTS_PER_DAY=5
TELEGRAM_RETRY_BASE_SECONDS=5
TELEGRAM_RETRY_MAX_SECONDS=300
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_REVIEWER_IDS=[]
TELEGRAM_WEBHOOK_SECRET=
MAX_ARTICLE_CHARS=100000
MAX_FETCH_BYTES=2000000
MAX_TELEGRAM_MESSAGE_LENGTH=4096
MAX_REQUESTS_PER_MINUTE=60
MAX_COLLECTION_SOURCES=10
MAX_SOURCE_REQUESTS_PER_RUN=30
MAX_COLLECTION_ITEMS_PER_RUN=100
COLLECTION_SCHEDULER_ENABLED=false
COLLECTION_SCHEDULER_INTERVAL_SECONDS=300
WEB_DISCOVERY_ENABLED=false
WEB_DISCOVERY_INTERVAL_SECONDS=3600
MAX_WEB_DISCOVERY_ITEMS_PER_RUN=5
MAX_LLM_ITEMS_PER_RUN=10
MAX_LLM_ITEMS_PER_DAY=100
MAX_COLLECTION_DURATION_SECONDS=120
MAX_ARTICLE_AGE_DAYS=30
MAX_VERIFICATION_CLAIMS=8
MAX_EVIDENCE_PER_CLAIM=3
MAX_VERIFICATION_REQUESTS=80
MAX_VERIFICATION_DURATION_SECONDS=120
IMPORTANCE_WEIGHTS={}
MIN_IMPORTANCE_SCORE=6.0
MIN_VERIFICATION_SCORE=0.8
